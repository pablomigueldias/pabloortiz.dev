# Arquivos estáticos servidos direto pela Cloudflare (sem passar pelo Worker).
# As páginas recebem os headers de segurança do next.config.ts; aqui vai o que
# também vale para JS, CSS, fontes e imagens.
# https://developers.cloudflare.com/workers/static-assets/headers
/*
  X-Content-Type-Options: nosniff

/_next/static/*
  Cache-Control: public,max-age=31536000,immutable
